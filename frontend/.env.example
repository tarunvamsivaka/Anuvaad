# =============================================================================
# Anuvaad Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
#
#   cp .env.example .env.local
#
# All NEXT_PUBLIC_* variables are exposed to the browser bundle.
# Never put secrets (service_role key, Razorpay key secret, etc.) here.
# =============================================================================

# ---------- Supabase ----------
# Project URL — found in Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon (public) key — found in Dashboard → Settings → API → Project API keys
# This key is public by design; all access is gated by Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------- Backend API ----------
# URL of the Anuvaad FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- PostHog Analytics ----------
# Project API key from PostHog → Settings → Project API Key
# Leave blank to disable analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key

# Set to "true" to enable PostHog capture in development (disabled by default)
# NEXT_PUBLIC_POSTHOG_DEBUG=true

# ---------- Frontend URL ----------
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ---------- Sentry Error Monitoring ----------
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-url

# ---------- Billing — Stripe Activation ----------
# Set to "true" to enable the live Stripe checkout button on the billing page.
# When "false" (default), the billing page shows a "Subscriptions Paused" state
# and users cannot purchase. Set ENABLE_BILLING=true in your backend env as well.
#
# Stripe Setup (Sprint 2):
#   1. Create products at https://dashboard.stripe.com/products
#   2. Copy the Price ID for each plan into STRIPE_PRICE_ID_PRO (backend .env)
#   3. Set STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET in backend .env
#   4. Set both ENABLE_BILLING=true (backend) and NEXT_PUBLIC_ENABLE_BILLING=true (here)
NEXT_PUBLIC_ENABLE_BILLING=false
