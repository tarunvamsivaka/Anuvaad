{
  "name": "@anuvaad/cli",
  "version": "1.0.0",
  "description": "AI-powered code translation CLI — translate, explain, and review code from your terminal",
  "homepage": "https://getanuvaad.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/anuvaad/anuvaad"
  },
  "bugs": {
    "url": "https://github.com/anuvaad/anuvaad/issues"
  },
  "license": "MIT",
  "bin": {
    "anuvaad": "./dist/index.js",
    "anuvaad-cli": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -watch -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {"useESM": false}]
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ]
  }
}
