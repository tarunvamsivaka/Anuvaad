{
  "name": "@anuvaad/cli",
  "version": "1.0.1",
  "description": "AI-powered code translation CLI — translate, explain, and review code from your terminal",
  "homepage": "https://getanuvaad.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/anuvaad/anuvaad"
  },
  "bugs": {
    "url": "https://github.com/anuvaad/anuvaad/issues"
  },
  "license": "MIT",
  "keywords": [
    "code-translation",
    "ai",
    "llm",
    "code-review",
    "code-modernization",
    "cli",
    "developer-tools",
    "ast",
    "tree-sitter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "anuvaad": "./dist/index.js",
    "anuvaad-cli": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -watch -p tsconfig.json",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {"useESM": false}]
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ]
  }
}
